# Retrieval works locally without any AI key.
GIM_DATABASE_URL=sqlite:///memory.db
GIM_EMBEDDER=hash

# Optional: fact extraction through OpenRouter or a compatible chat-completions API.
# Pick a model/endpoint that supports JSON Schema structured outputs.
GIM_LLM_API_KEY=
GIM_LLM_MODEL=
GIM_LLM_BASE_URL=https://openrouter.ai/api/v1

# Optional: local semantic embeddings. Install the semantic extra first.
# Set GIM_EMBEDDER=sentence-transformers and pin a full model commit revision.
GIM_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
GIM_EMBEDDING_REVISION=
